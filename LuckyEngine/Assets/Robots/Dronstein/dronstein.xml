<!-- The scene's MuJoCo world: the Holybro X500 V2 (physics in ../X500V2/x500v2.mjcf, written by
     tools/x500v2/build_x500v2.py; X500Flight.cs flies it). The trash can and the ground are Lucky collider entities
     that join this world. Air density/viscosity give the can its drag; the X500's geoms turn it off (X500.param sets
     its drag).
     The tennis balls are bodies here (their visuals are the scene's TennisBall_NN entities, which follow the bodies
     by body ID, 2 to 26 in this order). Lucky runs this world at a 0.002 s step. Each ball is a real tennis ball:
       mass 58 g, radius 33.5 mm, hollow (shell inertia 2/3 m r^2);
       bounce: solref 0.04 0.1 gives a rebound of about 0.45 to 0.6 of the drop height on a hard floor (a real ball:
         0.53 to 0.58 from 2.54 m) with a smooth 12 ms squash; unstable below dampratio 0.05;
       squeeze: solimp 0.83 sets the force against compression (1.0, 1.8, 3.6, 7.1 mm total at 10, 20, 40, 80 N;
         a real ball: 0.8, 1.6, 3.3, 6.5 mm);
       friction 0.65 sliding (felt on a hard court), 0.005 torsional, 0.0015 rolling (rolling resistance about 0.033);
       air: drag coefficient 0.55 (blunt_drag 0.275 is half of it in MuJoCo's convention; terminal speed about 22
         m/s), Magnus lift of a spinning ball (magnus_lift 0.72: it carries a fixed offset of 0.5, so the net lift is
         the ball's CL about 0.6 x spin ratio, topspin dips), slow spin decay (angular_drag 0.2, about 11% a second).
     priority 100 makes the ball's contact settings win against the ground and anything else it touches. -->
<mujoco model="dronstein">
  <option timestep="0.005" density="1.225" viscosity="1.8e-5" cone="elliptic" impratio="10"/>
  <default>
    <default class="tennis_ball">
      <geom type="sphere" size="0.0335" condim="6" priority="100" solref="0.04 0.1" solimp="0.83 0.83 0.01" friction="0.65 0.005 0.0015" fluidshape="ellipsoid" fluidcoef="0.275 0 0.2 0 0.72" group="3" rgba="0 0 0 0"/>
    </default>
  </default>
  <include file="../X500V2/x500v2.mjcf"/>
  <worldbody>
    <body name="TennisBall_01" pos="3.2375 -1.585 0.0335">
